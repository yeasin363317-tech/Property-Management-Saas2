# Copy to .env and CHANGE every value marked CHANGE before production use.

# --- Database (used by docker-compose) ---
POSTGRES_USER=pms
POSTGRES_PASSWORD=CHANGE_ME_use_letters_and_digits_only
POSTGRES_DB=pms

# --- Local development without Docker for the API (db published by docker-compose.dev.yml) ---
# DATABASE_URL=postgresql://pms:CHANGE_ME_use_letters_and_digits_only@localhost:5432/pms?schema=public
# TEST_DATABASE_URL=postgresql://pms:CHANGE_ME_use_letters_and_digits_only@localhost:5432/pms_test?schema=public

# --- App ---
NODE_ENV=production
PORT=4000
# Public URL users type in the browser (no trailing slash). CHANGE for production.
APP_ORIGIN=http://localhost:8080
# Comma-separated list of browser origins allowed to call the API. CHANGE for production.
CORS_ORIGINS=http://localhost:8080
# Set to true when serving over HTTPS (required for production).
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Number of reverse proxies in front of the API (nginx = 1).
TRUST_PROXY=1
# Set to false after creating your accounts to close public sign-up.
ENABLE_REGISTRATION=true
WEB_PORT=8080

# --- Optional email (password reset). Leave SMTP_HOST empty to disable. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional demo data (never enable in production) ---
# DEMO_SEED=true
# DEMO_PASSWORD=CHANGE_ME_demo_password_12
