generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum Role {
  LANDLORD
  ADMIN
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
  RENEWED
}

enum ObligationStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentKind {
  PAYMENT
  REVERSAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum ExpenseCategory {
  REPAIRS
  UTILITIES
  TAXES
  INSURANCE
  MANAGEMENT
  CLEANING
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum NotificationType {
  RENT_DUE
  RENT_OVERDUE
  LEASE_EXPIRING
  MAINTENANCE_UPDATE
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(LANDLORD)
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  resetTokens  PasswordResetToken[]

  properties    Property[]
  units         Unit[]
  tenants       Tenant[]
  leases        Lease[]
  obligations   RentObligation[]
  payments      RentPayment[] @relation("PaymentOwner")
  paymentsMade  RentPayment[] @relation("PaymentCreator")
  expenses      Expense[]
  maintenance   MaintenanceRequest[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @db.Uuid
  name        String
  address     String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  units        Unit[]
  expenses     Expense[]
  maintenance  MaintenanceRequest[]

  @@index([ownerId, archivedAt])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model Unit {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String     @db.Uuid
  propertyId  String     @db.Uuid
  number      String
  description String?
  monthlyRent Decimal    @db.Decimal(12, 2)
  status      UnitStatus @default(VACANT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  leases      Lease[]
  maintenance MaintenanceRequest[]

  @@unique([propertyId, number])
  @@index([ownerId])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model Tenant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String   @db.Uuid
  fullName         String
  email            String?
  phone            String?
  emergencyContact String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leases Lease[]

  @@index([ownerId, active])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model Lease {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String      @db.Uuid
  unitId          String      @db.Uuid
  tenantId        String      @db.Uuid
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  monthlyRent     Decimal     @db.Decimal(12, 2)
  securityDeposit Decimal     @default(0) @db.Decimal(12, 2)
  dueDay          Int
  status          LeaseStatus @default(ACTIVE)
  terminatedAt    DateTime?   @db.Date
  notes           String?
  renewedFromId   String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  renewedFrom Lease?           @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals    Lease[]          @relation("Renewal")
  obligations RentObligation[]

  @@index([ownerId, status])
  @@index([unitId])
  @@index([tenantId])
  @@index([status, endDate])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model RentObligation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String           @db.Uuid
  leaseId     String           @db.Uuid
  periodMonth DateTime         @db.Date
  dueDate     DateTime         @db.Date
  amountDue   Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  status      ObligationStatus @default(UNPAID)
  createdAt   DateTime         @default(now())

  lease    Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  payments RentPayment[]

  @@unique([leaseId, periodMonth])
  @@index([ownerId, dueDate])
  @@index([ownerId, status, dueDate])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model RentPayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String        @db.Uuid
  obligationId   String        @db.Uuid
  kind           PaymentKind   @default(PAYMENT)
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime      @db.Date
  method         PaymentMethod
  reference      String?
  note           String?
  idempotencyKey String?
  reversesId     String?       @unique @db.Uuid
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())

  obligation RentObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  reverses   RentPayment?   @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal   RentPayment?   @relation("Reversal")

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, paidAt])
  @@index([obligationId])
  owner User @relation("PaymentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
}

model Expense {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String          @db.Uuid
  propertyId String?         @db.Uuid
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  incurredAt DateTime        @db.Date
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([ownerId, incurredAt])
  @@index([propertyId])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model MaintenanceRequest {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String            @db.Uuid
  propertyId    String            @db.Uuid
  unitId        String?           @db.Uuid
  title         String
  description   String
  priority      Priority          @default(MEDIUM)
  status        MaintenanceStatus @default(OPEN)
  estimatedCost Decimal?          @db.Decimal(12, 2)
  actualCost    Decimal?          @db.Decimal(12, 2)
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([ownerId, status])
  @@index([propertyId])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([ownerId, dedupeKey])
  @@index([ownerId, readAt])
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([entity, entityId])
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}
